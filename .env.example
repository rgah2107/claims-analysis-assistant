# Compose reads this file from the project root. Copy it to .env.
# Chat is LLM_PROVIDER: fake (no key), gemini, openai, or local.
# This copy uses gemini for chat and embeddings. Paste GEMINI_API_KEY.
# With no .env file, Compose stays on the fake providers.
# Do not commit the copy that contains a key. Changing the embedding
# provider means: docker compose down -v
# and upload the documents again. The two vector spaces cannot be mixed.
# Changing only LLM_PROVIDER does not. Do not set fake as LLM_FALLBACK.

DATABASE_URL=postgresql+psycopg://claims:claims@localhost:5432/claims
REDIS_URL=redis://localhost:6379/0
DATA_DIR=./data

# fake: offline demo. gemini: Gemini. openai: api.openai.com. local: Bionic.
LLM_PROVIDER=gemini
LLM_FALLBACK=
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIM=384

GEMINI_API_KEY=
# 3.8 Flash is listed but was returning HTTP 503 under load. 3.5 Flash answers.
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
# Bionic: Settings → Local Model API. The port is the one in that screen's
# Base URL. This machine is 1235. The container uses host.docker.internal,
# not localhost. Set LLM_PROVIDER=local to use it.
LOCAL_LLM_BASE_URL=http://host.docker.internal:1235/v1
LOCAL_LLM_MODEL=gemma-3-12b-it
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT_SECONDS=180

LLM_TIMEOUT_SECONDS=20
MAX_UPLOAD_BYTES=15728640
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# console prints spans locally. none is used by pytest. otlp sends to a collector.
OTEL_EXPORTER=console
OTEL_ENDPOINT=http://localhost:4318

CHUNK_TARGET_CHARS=1200
CHUNK_OVERLAP_CHARS=200
RRF_K=60
RETRIEVAL_CANDIDATES=20
RETRIEVAL_LIMIT=5

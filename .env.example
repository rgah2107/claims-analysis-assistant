# Copy to backend/.env for a local API, or rely on docker-compose.yml,
# which injects these variables itself. Demo mode needs no API keys.

DATABASE_URL=postgresql+psycopg://claims:claims@localhost:5432/claims
REDIS_URL=redis://localhost:6379/0
DATA_DIR=./data

# fake keeps the demo and the tests deterministic. gemini and openai are real providers.
LLM_PROVIDER=fake
LLM_FALLBACK=
EMBEDDING_PROVIDER=fake
EMBEDDING_DIM=384

GEMINI_API_KEY=
# gemini-2.0-flash shut down on 2026-06-01. 3.8 Flash is a current free-tier model.
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini

LLM_TIMEOUT_SECONDS=20
MAX_UPLOAD_BYTES=15728640
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# console prints spans locally. none is used by pytest. otlp sends to a collector.
OTEL_EXPORTER=console
OTEL_ENDPOINT=http://localhost:4318

CHUNK_TARGET_CHARS=1200
CHUNK_OVERLAP_CHARS=200
RRF_K=60
RETRIEVAL_CANDIDATES=20
RETRIEVAL_LIMIT=5
